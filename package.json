{
  "name": "subtext",
  "description": "Language-learning companion for videos with subtitles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check . && pnpm check",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "web-ext:lint": "web-ext lint --source-dir .output/firefox-mv3",
    "web-ext:run": "web-ext run --source-dir .output/firefox-mv3 --start-url http://localhost:5555/player.html",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "fixtures:media": "node scripts/gen-fixture-media.mjs",
    "build:e2e": "wxt build -b firefox --mv3 --mode e2e",
    "e2e": "pnpm build:e2e && node scripts/e2e.mjs",
    "eval": "tsx eval/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "selenium-webdriver": "^4.51.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "idb": "^8.0.4"
  }
}
